# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Local MongoDB: mongodb://127.0.0.1:27017/ecommerce
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# JWT Secret Key (Use a strong random string in production)
JWT_SECRET=ecommerce_super_secret_jwt_key_2026

# Client URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173
